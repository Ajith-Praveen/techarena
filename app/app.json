{
  "expo": {
    "name": "Tech Arena",
    "slug": "tech-arena",
    "scheme": "techarena",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF6DF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.techarena.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.techarena.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#FFF6DF"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Tech Arena",
      "shortName": "Tech Arena",
      "themeColor": "#FFF6DF",
      "backgroundColor": "#FFF6DF"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#FFF6DF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tech Arena needs access to your photos so you can add your profile photo, project image and poster.",
          "cameraPermission": "Tech Arena needs camera access so you can take your profile photo or a picture of your project.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8dea7e52-7e12-421b-b979-149e76378d55"
      }
    },
    "owner": "ajithp7",
    "updates": {
      "url": "https://u.expo.dev/8dea7e52-7e12-421b-b979-149e76378d55"
    }
  }
}
