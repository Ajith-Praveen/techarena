# Base URL of the Tech Arena Cloudflare Worker (no trailing slash).
#
# Web (PWA served by the Worker): leave empty - the app calls the API on the same origin.
# Native (Expo Go / APK): REQUIRED. Examples:
#   Local dev with `wrangler dev` (phone on same Wi-Fi): http://192.168.1.20:8787
#   Deployed Worker:                                      https://tech-arena.<your-subdomain>.workers.dev
#
# Copy to `.env` (or `.env.local`) for local development. For EAS builds, set it in eas.json `env`.
EXPO_PUBLIC_API_URL=
