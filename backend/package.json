{
  "name": "tech-arena-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test --test-reporter=spec test/e2e.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "db:migrate:local": "wrangler d1 migrations apply tech-arena-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tech-arena-db --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "wrangler": "^4.157.0"
  }
}
